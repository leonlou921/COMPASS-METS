{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leonlou921/brats-mets-MicroBT/provenance/source_inventory.schema.json",
  "title": "N03 FINAL UTILITY V4 private source inventory",
  "type": "object",
  "required": [
    "schema_version",
    "candidate",
    "models",
    "learned_models",
    "assets",
    "frozen_asset_hashes_verified"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "candidate": {"const": "N03_FINAL_UTILITY_V4"},
    "frozen_asset_hashes_verified": {"const": true},
    "models": {
      "type": "object",
      "required": ["XL", "M", "FT"],
      "additionalProperties": false
    },
    "learned_models": {
      "type": "object",
      "required": [
        "lcv1_case",
        "lcv2_component",
        "rgv3_et",
        "utility_v4_existence",
        "utility_v4_geometry",
        "utility_v4_feature_names"
      ],
      "additionalProperties": false
    },
    "assets": {"type": "array"}
  },
  "additionalProperties": true
}
